# Voice-Enabled Transaction Agent API - Environment Configuration

# Server Port
PORT=3000

# Optional AI STT & LLM Providers (Uncomment if using external cloud AI models)
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIzaSy...
