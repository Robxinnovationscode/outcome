# Voice-Enabled Transaction Agent API - Environment Configuration

# Server Port
PORT=3000

# AI Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Firebase Admin SDK Configuration
# Option A: Base64 encoded JSON string of Firebase service account key
FIREBASE_SERVICE_ACCOUNT_KEY=
# Option B: Local relative or absolute path to service account JSON file
FIREBASE_KEY_PATH=secrets/firebase-admin.json

# LiveKit configuration for token generation & real-time voice streaming
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here
